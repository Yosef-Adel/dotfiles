" ============================================================================
" IdeaVim Configuration
" IntelliJ actions → Vim.xml (Alt/Ctrl shortcuts, work everywhere)
" This file → vim-native ops + things that need IdeaVim context
" ============================================================================

" ============================================================================
" IdeaVim Plugins
" ============================================================================
set surround
set commentary
set argtextobj
set textobj-entire
set highlightedyank
set easymotion
set multiple-cursors
set which-key

" ============================================================================
" IDE Behaviour
" ============================================================================
set ideajoin
set idearefactormode=keep
set ideamarks

" ============================================================================
" Key Handlers
" C-e → IDE (IntelliJ handles it for tree toggle via Vim.xml)
" Others → vim (IdeaVim owns them)
" ============================================================================
sethandler <C-e> a:ide
sethandler <C-d> a:vim
sethandler <C-u> a:vim
sethandler <C-h> a:vim
sethandler <C-l> a:vim
sethandler <C-j> a:vim
sethandler <C-k> a:vim
sethandler <C-o> a:vim
sethandler <C-i> n:vim
sethandler <C-p> a:vim
sethandler <C-n> a:vim

" ============================================================================
" Basic Settings
" ============================================================================
set number
set relativenumber
set scrolloff=10
set incsearch
set hlsearch
set ignorecase
set smartcase
set showmode
set visualbell
set noerrorbells

set clipboard+=unnamed
set clipboard+=ideaput

" ============================================================================
" Leader Key
" ============================================================================
let mapleader = " "

" ============================================================================
" Core Vim Motions
" ============================================================================

nnoremap <Esc> :nohlsearch<CR>

" Move lines up/down in visual mode
vnoremap J :m '>+1<CR>gv=gv
vnoremap K :m '<-2<CR>gv=gv

" Join lines without moving cursor
nnoremap J mzJ`z

" Centered scrolling
nnoremap <C-d> <C-d>zz
nnoremap <C-u> <C-u>zz
nnoremap G Gzz

" Line start/end
nnoremap gl $
vnoremap gl $
nnoremap gh ^
vnoremap gh ^

" ============================================================================
" Clipboard (vim register ops — must stay in IdeaVim)
" ============================================================================
nnoremap <A-y> "+y
vnoremap <A-y> "+y
nnoremap <A-Y> "+Y
xnoremap <A-p> "_dP

" ============================================================================
" Window Navigation (hjkl)
" ============================================================================
nnoremap <C-h> <C-w>h
nnoremap <C-l> <C-w>l
nnoremap <C-j> <C-w>j
nnoremap <C-k> <C-w>k

" ============================================================================
" LSP / Code Navigation (vim-style keys, must stay in IdeaVim)
" ============================================================================
nnoremap gd :action GotoDeclaration<CR>
nnoremap gD :action GotoTypeDeclaration<CR>
nnoremap gr :action FindUsages<CR>
nnoremap gi :action GotoImplementation<CR>
nnoremap gt :action GotoTypeDeclaration<CR>
nnoremap K  :action QuickJavaDoc<CR>

nnoremap ]d :action GotoNextError<CR>
nnoremap [d :action GotoPreviousError<CR>

" ============================================================================
" File Navigation (Ctrl — redundant with Vim.xml but needed for editor context)
" ============================================================================
nnoremap <C-p> :action GotoFile<CR>
nnoremap <C-n> :action GotoClass<CR>
nnoremap <C-o> :action Back<CR>
nnoremap <C-i> :action Forward<CR>

" ============================================================================
" Bookmarks (Harpoon equivalent)
" ============================================================================
nnoremap ma :action ToggleBookmark<CR>
nnoremap mm :action ShowBookmarks<CR>

nnoremap m1 :action GotoBookmark1<CR>
nnoremap m2 :action GotoBookmark2<CR>
nnoremap m3 :action GotoBookmark3<CR>
nnoremap m4 :action GotoBookmark4<CR>
nnoremap m5 :action GotoBookmark5<CR>
nnoremap m6 :action GotoBookmark6<CR>
nnoremap m7 :action GotoBookmark7<CR>
nnoremap m8 :action GotoBookmark8<CR>
nnoremap m9 :action GotoBookmark9<CR>

" ============================================================================
" EasyMotion (flash.nvim equivalent — IdeaVim plugin, must stay here)
" ============================================================================
map <A-j> <Plug>(easymotion-s)

" ============================================================================
" Visual Mode Refactoring (needs visual context — must stay in IdeaVim)
" ============================================================================
vnoremap <A-m> :action ExtractMethod<CR>
vnoremap <A-f> :action ExtractFunction<CR>

" ============================================================================
" Comments
" ============================================================================
nnoremap gcc :action CommentByLineComment<CR>
vnoremap gc  :action CommentByLineComment<CR>

" ============================================================================
" Completion
" ============================================================================
imap <C-y> <Action>(EditorChooseLookupItem)
