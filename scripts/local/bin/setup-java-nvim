#!/usr/bin/env bash
set -eo pipefail

# ============================================================
# setup-java-nvim: Install Java development tools for Neovim
#
# Installs: SDKMAN, Java 21, and Spring Boot LS jars
# Works on: macOS and Linux (WSL included)
# ============================================================

SPRING_BOOT_VERSION="2.0.1"
SPRING_BOOT_VSIX_URL="https://open-vsx.org/api/VMware/vscode-spring-boot/${SPRING_BOOT_VERSION}/file/VMware.vscode-spring-boot-${SPRING_BOOT_VERSION}.vsix"
SPRING_BOOT_LS_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/spring-boot-ls"

info() { printf "\033[1;34m==>\033[0m %s\n" "$1"; }
ok()   { printf "\033[1;32m  ✓\033[0m %s\n" "$1"; }
warn() { printf "\033[1;33m  !\033[0m %s\n" "$1"; }
err()  { printf "\033[1;31m  ✗\033[0m %s\n" "$1"; }

# -----------------------------------------------------------
# 1. SDKMAN
# -----------------------------------------------------------
info "Checking SDKMAN..."
if [ -d "$HOME/.sdkman" ]; then
    ok "SDKMAN already installed"
else
    info "Installing SDKMAN..."
    curl -s "https://get.sdkman.io?rcupdate=false" | bash
    ok "SDKMAN installed"
fi

export SDKMAN_DIR="$HOME/.sdkman"
# shellcheck source=/dev/null
source "$SDKMAN_DIR/bin/sdkman-init.sh"

# -----------------------------------------------------------
# 2. Java 21 (LTS)
# -----------------------------------------------------------
info "Checking Java 21..."
if sdk list java 2>/dev/null | grep -q "21.*-tem.*installed"; then
    ok "Java 21 Temurin already installed"
else
    info "Installing Java 21 Temurin..."
    sdk install java 21.0.6-tem <<< "Y" || true
    ok "Java 21 Temurin installed"
fi

# Set as default if no default set
if ! java -version 2>&1 | grep -q "21"; then
    info "Setting Java 21 as default..."
    sdk default java 21.0.6-tem <<< "Y" || true
fi

# -----------------------------------------------------------
# 3. Spring Boot Language Server
# -----------------------------------------------------------
info "Checking Spring Boot LS..."
if [ -d "$SPRING_BOOT_LS_DIR/language-server" ] && [ -d "$SPRING_BOOT_LS_DIR/jars" ]; then
    ok "Spring Boot LS already installed at $SPRING_BOOT_LS_DIR"
else
    info "Downloading Spring Boot LS v${SPRING_BOOT_VERSION}..."
    TMPDIR=$(mktemp -d)
    VSIX_FILE="$TMPDIR/spring-boot.vsix"

    if curl -fSL -o "$VSIX_FILE" "$SPRING_BOOT_VSIX_URL" 2>/dev/null; then
        info "Extracting Spring Boot LS jars..."
        mkdir -p "$SPRING_BOOT_LS_DIR"
        unzip -qo "$VSIX_FILE" -d "$TMPDIR/extracted"

        # Copy language server
        if [ -d "$TMPDIR/extracted/extension/language-server" ]; then
            cp -r "$TMPDIR/extracted/extension/language-server" "$SPRING_BOOT_LS_DIR/"
            ok "Language server extracted"
        fi

        # Copy jdt extension jars
        if [ -d "$TMPDIR/extracted/extension/jars" ]; then
            cp -r "$TMPDIR/extracted/extension/jars" "$SPRING_BOOT_LS_DIR/"
            ok "JDT extension jars extracted"
        fi

        rm -rf "$TMPDIR"
        ok "Spring Boot LS installed at $SPRING_BOOT_LS_DIR"
    else
        err "Failed to download Spring Boot LS. Trying alternative URL..."
        # Fallback: try GitHub releases from sts4
        rm -rf "$TMPDIR"
        warn "Install the VSCode extension manually: code --install-extension vmware.vscode-spring-boot"
    fi
fi

# -----------------------------------------------------------
# 4. Neovim Mason packages (reminder)
# -----------------------------------------------------------
info "Summary"
echo ""
echo "  Java development tools are ready."
echo "  Open Neovim and Mason will auto-install:"
echo "    - jdtls (Java Language Server)"
echo "    - java-debug-adapter"
echo "    - java-test"
echo ""
echo "  Spring Boot LS: $SPRING_BOOT_LS_DIR"
echo ""
echo "  Make sure your .zshrc sources SDKMAN:"
echo "    export SDKMAN_DIR=\"\$HOME/.sdkman\""
echo "    [[ -s \"\$SDKMAN_DIR/bin/sdkman-init.sh\" ]] && source \"\$SDKMAN_DIR/bin/sdkman-init.sh\""
echo ""
ok "Done!"
